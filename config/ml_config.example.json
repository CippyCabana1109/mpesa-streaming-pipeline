{
  "model_path": "models/anomaly_detector.pkl",
  "contamination": 0.1,
  "random_state": 42,
  "n_estimators": 100,
  "max_samples": "auto",
  "max_features": 1.0,
  "feature_columns": [
    "amount",
    "hour_of_day",
    "day_of_week",
    "day_of_month",
    "distance_from_nairobi",
    "user_transaction_count",
    "user_avg_amount",
    "amount_deviation",
    "time_since_last_txn",
    "is_weekend",
    "is_business_hours",
    "is_end_of_month"
  ],
  "retrain": {
    "enabled": true,
    "interval_hours": 24,
    "performance_threshold": 0.85,
    "min_training_samples": 1000
  },
  "prediction": {
    "anomaly_threshold": -0.1,
    "confidence_threshold": 0.7
  }
}

